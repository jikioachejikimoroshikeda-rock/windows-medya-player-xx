<Window
    x:Class="WindowsMediaPlayer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Media Player Next — WinUI">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="20,14" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox"
               PlaceholderText="Buscar en tu biblioteca…"
               TextChanged="SearchBox_TextChanged"
               VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Content="＋  Agregar archivos"
              Click="AddFiles_Click"
              VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,4,4,18">
            <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}">
              <TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Windows Media Player" FontWeight="SemiBold" />
              <TextBlock Text="Next · WinUI 3" Opacity="0.7" FontSize="12" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="BIBLIOTECA" Opacity="0.65" FontSize="11" Margin="4,0,0,4" />
          <Button Content="⌂   Inicio" Tag="Inicio" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          <Button Content="♫   Música" Tag="Música" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          <Button Content="▣   Vídeos" Tag="Vídeos" Click="Navigate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          <TextBlock Text="Reproductor nativo de Windows" Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="4,18,4,0" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Padding="20,16" RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock x:Name="PageTitle" Text="Inicio" FontSize="26" FontWeight="SemiBold" />
          <TextBlock x:Name="LibraryCount" Text="·  0 elementos" VerticalAlignment="Bottom" Opacity="0.7" Margin="0,0,0,4" />
        </StackPanel>
        <Border Grid.Row="1" Background="#0B1522" CornerRadius="12" BorderBrush="#26374C" BorderThickness="1" ClipToBounds="True">
          <Grid>
            <MediaPlayerElement x:Name="PlayerElement" AreTransportControlsEnabled="True" AutoPlay="False" />
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
              <TextBlock Text="♫" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="Agrega un archivo para comenzar" FontSize="16" HorizontalAlignment="Center" />
              <TextBlock Text="Audio y vídeo compatibles con Windows" Opacity="0.7" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Ahora reproduciendo:" Opacity="0.7" />
          <TextBlock x:Name="NowPlayingTitle" Text="Nada seleccionado" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>

      <Border Grid.Column="2" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Spacing="3">
            <TextBlock Text="Biblioteca y cola" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Selecciona un elemento para reproducir" Opacity="0.7" FontSize="12" />
          </StackPanel>
          <ListView x:Name="LibraryList" Grid.Row="1" SelectionChanged="LibraryList_SelectionChanged">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Padding="8,6" Spacing="3">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Details}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Grid.Row="2" Text="Los formatos reproducibles dependen de los códecs de Windows instalados." Opacity="0.65" FontSize="11" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Text="Windows Media Player Next · edición WinUI 3" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" Margin="16,8" />
  </Grid>
</Window>
