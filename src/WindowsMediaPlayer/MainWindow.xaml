<Window x:Class="WindowsMediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Windows Media Player Next" Width="1280" Height="800" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#101B2B" Foreground="#F3F6FB">
  <Window.Resources>
    <Style TargetType="Button" x:Key="NavButton"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C5D0DF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="2"/></Style>
    <Style TargetType="Button" x:Key="ActionButton"><Setter Property="Background" Value="#263B55"/><Setter Property="Foreground" Value="#F3F6FB"/><Setter Property="BorderBrush" Value="#38516E"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="3,0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBlock" x:Key="Muted"><Setter Property="Foreground" Value="#9EADC1"/><Setter Property="FontSize" Value="12"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#121F31" BorderBrush="#26374C" BorderThickness="0,0,1,0">
      <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="8,8,4,22"><Border Width="38" Height="38" CornerRadius="11" Background="#238BEE"><TextBlock Text="▶" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Margin="10,2,0,0"><TextBlock Text="Windows Media Player" FontWeight="SemiBold"/><TextBlock Text="Next · edición Pro" Foreground="#8091A8" FontSize="11"/></StackPanel></StackPanel>
          <TextBlock Text="BIBLIOTECA" Foreground="#8091A8" FontSize="10" Margin="12,0,0,7"/>
          <Button Style="{StaticResource NavButton}" Content="⌂   Inicio" Tag="Inicio" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="♫   Música" Tag="Música" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="▣   Vídeos" Tag="Vídeos" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="◉   Podcasts" Tag="Podcasts" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="▤   Audiolibros" Tag="Audiolibros" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="◉   Radio" Tag="Radio" Click="Navigate_Click"/>
          <Button Style="{StaticResource NavButton}" Content="☷   Listas de reproducción" Tag="Listas" Click="Navigate_Click"/>
          <TextBlock Text="AGRUPAR POR" Foreground="#8091A8" FontSize="10" Margin="12,22,0,7"/>
          <ComboBox x:Name="GroupByBox" Margin="6,0,6,0" SelectedIndex="0" Height="30" SelectionChanged="GroupBy_Changed"><ComboBoxItem Content="Artista"/><ComboBoxItem Content="Álbum"/><ComboBoxItem Content="Género"/><ComboBoxItem Content="Año"/><ComboBoxItem Content="BPM"/><ComboBoxItem Content="Estado de ánimo"/></ComboBox>
          <Button Style="{StaticResource ActionButton}" Content="＋ Agregar archivos" Click="AddFiles_Click" Margin="5,18,5,4"/>
          <Button Style="{StaticResource ActionButton}" Content="▧ Abrir imágenes" Click="OpenImages_Click" Margin="5,4"/>
          <Button Style="{StaticResource ActionButton}" Content="◉ Radio URL" Click="OpenRadio_Click" Margin="5,4"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="8"><TextBlock Text="Reproductor nativo para Windows" Foreground="#8091A8" FontSize="11"/><TextBlock Text="Windows 10 y 11 · Audio · Vídeo" Foreground="#63758D" FontSize="10" Margin="0,4,0,0"/></StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="20,16,16,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource ActionButton}" Content="◀ Anterior" Click="Previous_Click"/><Button Style="{StaticResource ActionButton}" Content="▶ / Ⅱ" x:Name="PlayButton" Click="PlayPause_Click"/><Button Style="{StaticResource ActionButton}" Content="Siguiente ▶" Click="Next_Click"/><Button Style="{StaticResource ActionButton}" Content="⤨" Click="Shuffle_Click"/><Button Style="{StaticResource ActionButton}" Content="↻" Click="Repeat_Click"/></StackPanel>
        <TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center" Padding="10,0" Background="#1B2C41" Foreground="White" BorderBrush="#30455F" Text="Buscar en tu biblioteca…" TextChanged="Search_Changed"/>
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock x:Name="PageTitle" Text="Inicio" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="LibraryCount" Text="  ·  0 elementos" Foreground="#9EADC1" VerticalAlignment="Center"/></DockPanel>
      <Grid Grid.Row="2" x:Name="ContentArea">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0B1522" CornerRadius="12" BorderBrush="#26374C" BorderThickness="1" ClipToBounds="True">
          <Grid>
            <vlc:VideoView x:Name="VideoSurface" Visibility="Visible"/>
            <Image x:Name="ImageSurface" Visibility="Collapsed" Stretch="Uniform" Margin="16"/>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="♫" FontSize="48" Foreground="#64B9FF" HorizontalAlignment="Center"/><TextBlock Text="Agrega música o vídeo para comenzar" Foreground="#9EADC1"/></StackPanel>
            <Border VerticalAlignment="Bottom" Background="#B20B1522" Padding="10" IsHitTestVisible="False"><TextBlock x:Name="CurrentMediaLabel" Text="Listo para reproducir" Foreground="#DCE6F2"/></Border>
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="#17263A" CornerRadius="9" Margin="0,12,0,0" Padding="12">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0"><StackPanel DockPanel.Dock="Left" Width="190"><TextBlock x:Name="NowTitle" Text="Selecciona un archivo" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowSubtitle" Text="Tu biblioteca multimedia" Foreground="#9EADC1" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock x:Name="TimeLabel" Text="0:00 / 0:00" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9EADC1"/></DockPanel>
            <Slider x:Name="ProgressSlider" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Margin="4,8,4,0" ValueChanged="Progress_Changed"/>
          </Grid>
        </Border>
      </Grid>
      <TextBlock Grid.Row="3" Text="La ecualización y el ajuste de imagen actúan sobre la reproducción; no cambian los datos originales del archivo." Foreground="#73849A" FontSize="10" Margin="2,9,0,0" TextWrapping="Wrap"/>
    </Grid>

    <Border Grid.Column="2" Background="#131F30" BorderBrush="#26374C" BorderThickness="1,0,0,0" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Sonido y vídeo" FontSize="17" FontWeight="SemiBold" Margin="4,7,0,3"/>
          <TextBlock Text="Ecualizador de 10 bandas · ajusta graves, medios y agudos" Foreground="#9EADC1" FontSize="11" TextWrapping="Wrap" Margin="4,0,4,10"/>
          <TextBlock Text="Graves" Foreground="#DCE6F2"/><Slider x:Name="BassSlider" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="Equalizer_Changed"/><TextBlock Text="Medios" Foreground="#DCE6F2"/><Slider x:Name="MidSlider" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" ValueChanged="Equalizer_Changed"/><TextBlock Text="Agudos" Foreground="#DCE6F2"/><Slider x:Name="TrebleSlider" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" ValueChanged="Equalizer_Changed"/>
          <TextBlock x:Name="TuningStatus" Text="Ecualizador plano" Foreground="#64B9FF" FontSize="10" Margin="2,0,2,10"/>
          <TextBlock Text="Proporción de imagen" Foreground="#DCE6F2"/><ComboBox x:Name="VideoAspectBox" SelectedIndex="0" Margin="0,4,0,8" SelectionChanged="VideoAspect_Changed"><ComboBoxItem Content="Original" Tag=""/><ComboBoxItem Content="16:9" Tag="16:9"/><ComboBoxItem Content="4:3" Tag="4:3"/><ComboBoxItem Content="1:1" Tag="1:1"/></ComboBox>
          <TextBlock Text="Escala de vídeo" Foreground="#DCE6F2"/><ComboBox x:Name="VideoScaleBox" SelectedIndex="0" Margin="0,4,0,4" SelectionChanged="VideoScale_Changed"><ComboBoxItem Content="Ajustar a ventana" Tag="0"/><ComboBoxItem Content="50 %" Tag="0.5"/><ComboBoxItem Content="75 %" Tag="0.75"/><ComboBoxItem Content="100 %" Tag="1"/><ComboBoxItem Content="150 %" Tag="1.5"/><ComboBoxItem Content="200 %" Tag="2"/></ComboBox>
          <TextBlock Text="El tamaño de salida depende también del vídeo original y de la ventana." Foreground="#71839A" FontSize="10" TextWrapping="Wrap" Margin="2,5,2,12"/>
          <TextBlock Text="Biblioteca y cola" FontSize="16" FontWeight="SemiBold" Margin="4,6,0,3"/><TextBlock Text="Selecciona un elemento para reproducir" Foreground="#9EADC1" FontSize="11" Margin="4,0,0,6"/>
        </StackPanel>
        <ListBox x:Name="MediaList" Background="Transparent" BorderThickness="0" Foreground="#E5ECF5" SelectionChanged="MediaList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate><Border Padding="8" Margin="0,2" Background="#1A2A3F" CornerRadius="7"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="#91A2B8" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock DockPanel.Dock="Bottom" Text="Añade archivos locales con «Agregar archivos»." Foreground="#71839A" FontSize="10" TextWrapping="Wrap" Margin="4,10,4,4"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
